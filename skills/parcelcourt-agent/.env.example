# --- Network / contract ---
# Same values as app/.env.local's unprefixed copies (GENLAYER_CHAIN,
# GENLAYER_CONTRACT_ADDRESS) and deploy/001_deploy_parcel_court.ts. Safe to
# reuse verbatim — none of these are sensitive.
GENLAYER_CHAIN=studionet
GENLAYER_CONTRACT_ADDRESS=
# Only needed if GENLAYER_CHAIN isn't one of: localnet, studionet, testnetAsimov, testnetBradbury
GENLAYER_RPC_URL=
GENLAYER_CHAIN_ID=

# --- Writes: disabled by default ---
# Set to 1 to register open_claim / submit_evidence / adjudicate as
# callable tools. Leave unset (or anything other than "1") to run this
# skill read-only. Read SKILL.md's trust-boundary section before enabling.
PARCELCOURT_ENABLE_WRITES=0

# Real private key. Deliberately a SEPARATE key from GENLAYER_DEPLOYER_KEY
# — use a dedicated, purpose-funded wallet for this always-on agent
# identity, not your human-run deploy key. Only read when
# PARCELCOURT_ENABLE_WRITES=1.
PARCELCOURT_AGENT_PRIVATE_KEY=
