# --- Mock mode (default for judges without Studio running) ---
# Renders the full UI against tests/direct fixtures, no chain required.
NEXT_PUBLIC_MOCK=1

# --- Live mode: read by the deployed app (app/lib/genlayer.ts) ---
# Set NEXT_PUBLIC_MOCK=0 and fill these in to run against a real
# GenLayer Studio instance or testnet.
#
# All NEXT_PUBLIC_-prefixed on purpose: adjudicate() runs client-side (it
# needs window.ethereum for wallet signing, which can't move to a server
# action), so these have to be readable in the browser bundle. None of them
# are sensitive — a chain name, a deployed contract address, and a demo
# wallet's public *address* (not a key).
#
# One of: localnet, studionet, testnetAsimov, testnetBradbury
# (the named chains genlayer-js exports from "genlayer-js/chains")
NEXT_PUBLIC_GENLAYER_CHAIN=studionet
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
# Optional: headless demo signer if no wallet extension is available.
NEXT_PUBLIC_GENLAYER_DEMO_ACCOUNT=

# --- Deploy/seed CLI scripts only (deploy/, scripts/) ---
# These run as plain `tsx` Node scripts, never bundled into the app, so
# they don't need (and shouldn't use) the NEXT_PUBLIC_ prefix. Keep
# GENLAYER_CONTRACT_ADDRESS below in sync with the NEXT_PUBLIC_ copy above
# after each deploy — same address, two different execution contexts.
GENLAYER_CHAIN=studionet
GENLAYER_CONTRACT_ADDRESS=
# Real private key — used only by these scripts, NEVER prefix this
# NEXT_PUBLIC_ or it will end up in the browser bundle.
GENLAYER_DEPLOYER_KEY=
