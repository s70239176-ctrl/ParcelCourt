# --- Mock mode (default for judges without Studio running) ---
# Renders the full UI against tests/direct fixtures, no chain required.
NEXT_PUBLIC_MOCK=1

# --- Live mode ---
# Set NEXT_PUBLIC_MOCK=0 and fill these in to run against a real
# GenLayer Studio instance or testnet.
# One of: localnet, studionet, testnetAsimov, testnetBradbury
# (the named chains genlayer-js exports from "genlayer-js/chains")
GENLAYER_CHAIN=studionet
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_DEPLOYER_KEY=
# Optional: headless demo signer if no wallet extension is available.
GENLAYER_DEMO_ACCOUNT=
